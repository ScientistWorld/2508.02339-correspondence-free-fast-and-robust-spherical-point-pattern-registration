# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
#
# Use a Quay-hosted Rocky Linux base to avoid Docker Hub pull-rate limits.
# Install Python and basic shell tools via dnf in `%post`.

Bootstrap: docker
From: quay.io/rockylinux/rockylinux:9

%post
    dnf install -y \
        python3 python3-pip \
        tmux nano vim-minimal less curl wget git && \
    ln -sf /usr/bin/vi /usr/bin/vim && \
    dnf clean all

    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
