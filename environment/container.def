# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
# Avoid OCI registry fetches entirely because the scheduler repeatedly receives
# malformed registry metadata responses. Use RPM bootstrap instead of
# debootstrap because the build host does not have the debootstrap binary.

Bootstrap: yum
OSVersion: 9
MirrorURL: http://dl.rockylinux.org/pub/rocky/%{OSVERSION}/BaseOS/x86_64/os/
Include: ca-certificates,python3,python3-pip

%post
    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
