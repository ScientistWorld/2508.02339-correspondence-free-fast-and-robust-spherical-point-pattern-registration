# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
# This definition avoids OCI registry fetches entirely because repeated remote
# metadata responses were malformed on the cluster. Instead, it unpacks a local
# Ubuntu base rootfs tarball during %setup, then installs only minimal OS deps.

Bootstrap: scratch

%setup
    ROOTFS="${APPTAINER_ROOTFS:-$SINGULARITY_ROOTFS}"
    TARBALL="/tmp/ubuntu-base-22.04-base-amd64.tar.gz"
    if [ ! -f "$TARBALL" ]; then
        if command -v wget >/dev/null 2>&1; then
            wget -O "$TARBALL" "https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04-base-amd64.tar.gz"
        elif command -v curl >/dev/null 2>&1; then
            curl -L "https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04-base-amd64.tar.gz" -o "$TARBALL"
        else
            python3 - <<'PY'
import urllib.request
urllib.request.urlretrieve(
    "https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04-base-amd64.tar.gz",
    "/tmp/ubuntu-base-22.04-base-amd64.tar.gz",
)
PY
        fi
    fi
    tar -xzf "$TARBALL" -C "$ROOTFS"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y \
        ca-certificates \
        python3 \
        python3-pip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
