# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
#
# Uses mirror.gcr.io to proxy Docker Hub, bypassing unauthenticated rate limits.

Bootstrap: docker
From: mirror.gcr.io/library/python:3.11-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        tmux nano vim-tiny less curl wget git && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
