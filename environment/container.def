# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — keep the container minimal and portable.

Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y \
        ca-certificates \
        python3 \
        python3-pip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/python-packages /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONPATH=/opt/python-packages${PYTHONPATH:+:$PYTHONPATH}
    export PYTHONUNBUFFERED=1
