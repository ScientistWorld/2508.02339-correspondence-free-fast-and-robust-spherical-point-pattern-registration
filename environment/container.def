# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
# Use a public Quay base image to avoid the previous GHCR auth failure, the
# malformed Docker Hub metadata responses, and the fakeroot limitations of yum
# bootstrap on this cluster.

Bootstrap: docker
From: quay.io/centos/centos:stream9

%post
    dnf install -y \
        ca-certificates \
        python3 \
        python3-pip && \
    dnf clean all

    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
