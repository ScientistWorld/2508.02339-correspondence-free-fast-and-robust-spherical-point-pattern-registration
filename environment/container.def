# Apptainer definition file for Spherical Point Pattern Registration.
#
# Build:  apptainer build container.sif container.def
#
# CPU-only computation — no GPU needed for these O(n) algorithms.
# This definition avoids OCI registry fetches entirely because repeated remote
# metadata responses were malformed on the cluster. Instead, it unpacks a local
# Ubuntu base rootfs tarball during %setup, then installs only minimal OS deps.

Bootstrap: scratch

%setup
    ROOTFS="${APPTAINER_ROOTFS:-$SINGULARITY_ROOTFS}"
    TARBALL=""
    for CANDIDATE in \
        "./environment/ubuntu-base-22.04-base-amd64.tar.gz" \
        "$PWD/environment/ubuntu-base-22.04-base-amd64.tar.gz" \
        "/home/user/environment/ubuntu-base-22.04-base-amd64.tar.gz"
    do
        if [ -f "$CANDIDATE" ]; then
            TARBALL="$CANDIDATE"
            break
        fi
    done
    if [ -z "$TARBALL" ]; then
        TARBALL="$(find "$PWD" -maxdepth 4 -name 'ubuntu-base-22.04-base-amd64.tar.gz' -print -quit 2>/dev/null)"
    fi
    if [ -z "$TARBALL" ]; then
        echo "Could not locate ubuntu-base-22.04-base-amd64.tar.gz from build working directory: $PWD" >&2
        exit 1
    fi
    tar -xzf "$TARBALL" -C "$ROOTFS"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y \
        ca-certificates \
        python3 \
        python3-pip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data /home/user/checkpoints
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
